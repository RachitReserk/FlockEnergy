                        },
                        "hierarchy": {
                          "type": "object",
                          "properties": {
                            "zone": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                }
                              }
                            },
                            "circle": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                }
                              }
                            },
                            "division": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                }
                              }
                            },
                            "subdivision": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                }
                              }
                            },
                            "substation": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                }
                              }
                            },
                            "feeder": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
