    },
    "/api/v1/dts/": {
      "get": {
        "summary": "List Distribution Transformers",
        "tags": [
          "Distribution Transformers"
        ],
        "description": "Returns a paginated list of distribution transformers with connected meter counts and filtering by feeder or capacity.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "pageSize",
            "required": false,
            "description": "Items per page"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "feederCode",
            "required": false,
            "description": "Filter by feeder code (e.g. F-001)"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0
            },
            "in": "query",
            "name": "minCapacityKva",
            "required": false,
            "description": "Minimum transformer capacity in kVA"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0
            },
            "in": "query",
            "name": "maxCapacityKva",
            "required": false,
            "description": "Maximum transformer capacity in kVA"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "q",
            "required": false,
            "description": "Search by DT code or name"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of distribution transformers",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Paginated list of distribution transformers",
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "example": "DT-001"
                          },
                          "name": {
                            "type": "string",
                            "example": "Malviya Nagar DT 1"
                          },
                          "feederCode": {
